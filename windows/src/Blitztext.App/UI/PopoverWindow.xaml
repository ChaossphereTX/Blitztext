<Window x:Class="Blitztext.App.UI.PopoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blitztext"
        Width="340" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True">
    <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16"
            BorderBrush="#33FFFFFF" BorderThickness="1">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,12">
                <TextBlock Text="Blitztext" Foreground="{StaticResource TextBrush}"
                           FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button x:Name="SettingsButton" Content="⚙"  HorizontalAlignment="Right"
                        Foreground="{StaticResource TextMutedBrush}" Background="Transparent"
                        BorderThickness="0" FontSize="16" Cursor="Hand" Click="OnSettingsClick" />
            </Grid>

            <!-- Status -->
            <Border x:Name="StatusBorder" Background="{StaticResource PanelMutedBrush}"
                    CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource TextBrush}"
                               FontSize="12.5" TextWrapping="Wrap" />
                    <Border x:Name="LevelTrack" Height="4" CornerRadius="2" Margin="0,8,0,0"
                            Background="#22FFFFFF" Visibility="Collapsed" HorizontalAlignment="Stretch">
                        <Border x:Name="LevelBar" Background="{StaticResource AccentBrush}"
                                CornerRadius="2" HorizontalAlignment="Left" Width="0" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Onboarding -->
            <StackPanel x:Name="OnboardingPanel" Visibility="Collapsed">
                <TextBlock Foreground="{StaticResource TextBrush}" FontSize="13" TextWrapping="Wrap"
                           Text="Willkommen bei Blitztext. Hinterlege zum Loslegen einen OpenAI API Key oder installiere ein lokales Modell." />
                <Button Content="Einstellungen öffnen" Margin="0,12,0,0" Padding="10,6"
                        Click="OnSettingsClick" Cursor="Hand" />
            </StackPanel>

            <!-- Workflow list -->
            <StackPanel x:Name="WorkflowList" />

            <!-- Stop button (visible while busy) -->
            <Button x:Name="StopButton" Content="Stoppen" Margin="0,12,0,0" Padding="10,8"
                    Visibility="Collapsed" Click="OnStopClick" Cursor="Hand" />
        </StackPanel>
    </Border>
</Window>
