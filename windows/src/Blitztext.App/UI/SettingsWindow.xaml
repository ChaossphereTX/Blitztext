<Window x:Class="Blitztext.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blitztext – Einstellungen"
        Width="460" Height="640"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Grid Margin="0">
        <TabControl Margin="8">
            <!-- ===== Anpassen ===== -->
            <TabItem Header="Anpassen">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">

                        <TextBlock Text="SICHERER LOKALER MODUS" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,6" />
                        <CheckBox x:Name="SecureLocalCheck" Content="Sicherer Lokaler Modus (Transkription nur lokal)" />
                        <TextBlock Text="Lokales Modell" FontSize="11" Opacity="0.7" Margin="0,10,0,4" />
                        <ComboBox x:Name="ModelCombo" />
                        <ProgressBar x:Name="DownloadProgress" Height="6" Margin="0,8,0,2" Minimum="0" Maximum="1" Visibility="Collapsed" />
                        <TextBlock x:Name="DownloadStatus" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                        <Button x:Name="DownloadButton" Content="Modell installieren" Margin="0,8,0,0" Padding="8,4" HorizontalAlignment="Left" Click="OnDownloadModel" />
                        <TextBlock x:Name="DownloadError" FontSize="11" Foreground="#C0392B" TextWrapping="Wrap" Margin="0,4,0,0" />

                        <Separator Margin="0,16" />

                        <TextBlock Text="TASTENKÜRZEL" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,6" />
                        <StackPanel x:Name="HotkeyList" Margin="0,0,0,8" />
                        <TextBlock Text="Modus" FontSize="11" Opacity="0.7" Margin="0,4,0,4" />
                        <ComboBox x:Name="HotkeyModeCombo" HorizontalAlignment="Left" Width="220">
                            <ComboBoxItem Content="Halten (Push-to-talk)" />
                            <ComboBoxItem Content="Drücken (Umschalten)" />
                        </ComboBox>

                        <Separator Margin="0,16" />

                        <TextBlock Text="BLITZTEXT+" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,6" />
                        <TextBlock Text="Schreibstil" FontSize="11" Opacity="0.7" Margin="0,0,0,4" />
                        <ComboBox x:Name="ToneCombo" HorizontalAlignment="Left" Width="220">
                            <ComboBoxItem Content="Formell" />
                            <ComboBoxItem Content="Neutral" />
                            <ComboBoxItem Content="Locker" />
                        </ComboBox>
                        <TextBlock Text="Eigene Anweisung" FontSize="11" Opacity="0.7" Margin="0,10,0,4" />
                        <TextBox x:Name="ImprovePrompt" Height="64" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                        <TextBlock Text="Kontext" FontSize="11" Opacity="0.7" Margin="0,10,0,4" />
                        <TextBox x:Name="ImproveContext" />

                        <Separator Margin="0,16" />

                        <TextBlock Text="BLITZTEXT $%&amp;!" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,6" />
                        <TextBlock Text="Eigene Anweisung" FontSize="11" Opacity="0.7" Margin="0,0,0,4" />
                        <TextBox x:Name="DampfPrompt" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />

                        <Separator Margin="0,16" />

                        <TextBlock Text="BLITZTEXT :)" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,6" />
                        <TextBlock Text="Emoji-Dichte" FontSize="11" Opacity="0.7" Margin="0,0,0,4" />
                        <ComboBox x:Name="EmojiCombo" HorizontalAlignment="Left" Width="220">
                            <ComboBoxItem Content="Wenig" />
                            <ComboBoxItem Content="Mittel" />
                            <ComboBoxItem Content="Viel" />
                        </ComboBox>

                        <Separator Margin="0,16" />

                        <TextBlock Text="EIGENNAMEN" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,6" />
                        <StackPanel x:Name="TermsList" Margin="0,0,0,6" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="+" Width="32" Margin="6,0,0,0" Click="OnAddTerm" />
                            <TextBox x:Name="NewTerm" />
                        </DockPanel>

                        <TextBlock Text="Sprache (ISO-Code, z. B. de, en)" FontSize="11" Opacity="0.7" Margin="0,16,0,4" />
                        <TextBox x:Name="LanguageBox" HorizontalAlignment="Left" Width="120" />

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Zugang ===== -->
            <TabItem Header="Zugang">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="OPENAI API KEY" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,6" />
                        <TextBlock x:Name="ApiKeyStatus" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap" />
                        <PasswordBox x:Name="ApiKeyBox" />
                        <TextBlock Text="Der Key wird im Windows Credential Manager gespeichert. Audio und Text gehen direkt an die OpenAI API."
                                   FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <Button x:Name="SaveKeyButton" Content="API Key speichern" Margin="0,8,0,0" Padding="8,4" HorizontalAlignment="Left" Click="OnSaveApiKey" />
                        <TextBlock x:Name="ApiKeyMessage" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />

                        <Separator Margin="0,16" />

                        <TextBlock Text="BEIM ANMELDEN" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,6" />
                        <CheckBox x:Name="StartupCheck" Content="Blitztext automatisch starten" Click="OnToggleStartup" />

                        <Separator Margin="0,16" />

                        <TextBlock Text="HINWEIS" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,6" />
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.85"
                                   Text="Auf Windows wird der Text per simuliertem Strg+V eingefügt. Ein gesondertes Berechtigungsrecht wie unter macOS ist nicht nötig – das Zielfenster muss nur den Fokus annehmen können." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Button Content="Speichern &amp; schließen" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,18,12" Padding="12,6" Click="OnSaveAndClose" />
    </Grid>
</Window>
