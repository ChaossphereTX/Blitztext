<Project Sdk="Microsoft.NET.Sdk">

  <!-- Manual end-to-end harness. NOT part of Blitztext.sln; run explicitly with:
       dotnet run with an optional model-name argument (default: base). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Blitztext.E2E</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Blitztext.Core\Blitztext.Core.csproj" />
    <ProjectReference Include="..\..\src\Blitztext.App\Blitztext.App.csproj" />
  </ItemGroup>

</Project>
